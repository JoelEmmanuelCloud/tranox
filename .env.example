# Celo mainnet
CELO_RPC_URL=https://forno.celo.org

# Attribution tag issued by Loops House — every counted tx must carry it
CELO_ATTRIBUTION_TAG=celo_37620e33107f

# Agent hot wallet (run `npm run wallet:new`). NEVER commit the real .env.
AGENT_PRIVATE_KEY=0x...

# Textile FX (keyless works; leave blank unless you get a partner key)
TEXTILE_API_URL=https://api.textilecredit.com/v2
TEXTILE_API_KEY=

# Guardrails (USD₮ amounts)
MAX_PAYOUT_USDT=100
MAX_DAILY_USDT=300

# Hours a payout can wait for corridor liquidity before it is marked failed
MAX_QUEUE_HOURS=24

# Comma-separated freelancer wallets allowed to receive payouts. Empty means no payouts are sent.
FREELANCER_ALLOWLIST=

# GoWork PocketBase
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# ERC-8004 agent card (hosted JSON: GitHub raw, IPFS, or your domain)
AGENT_CARD_URI=https://raw.githubusercontent.com/JoelEmmanuelCloud/tranox/main/agent-card.json
